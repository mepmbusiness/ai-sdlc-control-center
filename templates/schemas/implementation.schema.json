{
  "$id": "aisdlc.implementation-response/v1",
  "description": "Final response of the Software Engineer. Code is written directly in the sandboxed workspace; this response is the engineer's report, saved by the Control Center as engineering/implementation-notes.md.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "summary": {
      "type": "string"
    },
    "tasks_completed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Task IDs from the implementation plan, e.g. T-1."
    },
    "tasks_remaining": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "how_to_run": {
      "type": "string",
      "description": "One command to start the app."
    },
    "fixes": {
      "type": "array",
      "description": "On a fix run: one entry per blocker received, saying what was done.",
      "items": {
        "type": "object",
        "properties": {
          "blocker": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          }
        },
        "required": [
          "blocker",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "notes_for_reviewers": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "screens": {
      "type": "array",
      "description": "Every screen from the design's screen inventory and the URL path that shows it, so Design QA can take screenshots.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Screen ID from the design, e.g. S1."
          },
          "path": {
            "type": "string",
            "description": "URL path relative to the app root, e.g. / or /staff/slots."
          }
        },
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "summary",
    "tasks_completed",
    "tasks_remaining",
    "files_changed",
    "how_to_run",
    "fixes",
    "screens",
    "notes_for_reviewers",
    "blockers"
  ],
  "additionalProperties": false
}
